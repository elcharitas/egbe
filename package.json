{
  "name": "egbe",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --include-runtime false",
    "db:migrate": "wrangler d1 migrations apply egbe-circle --local",
    "test": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "jose": "6.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261009.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "4.149.0"
  }
}
